@model AssetPortal.Models.Asset

<h1>Edit Asset</h1>

<form method="post">

    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="All"
         class="text-danger">
    </div>

    <div class="mb-3">

        <label>Asset Tag</label>

        <input asp-for="AssetTag"
               class="form-control" />

        <span asp-validation-for="AssetTag"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label>Asset Name</label>

        <input asp-for="AssetName"
               class="form-control" />

        <span asp-validation-for="AssetName"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label>Owner</label>

        <input asp-for="Owner"
               class="form-control" />

        <span asp-validation-for="Owner"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

</form>