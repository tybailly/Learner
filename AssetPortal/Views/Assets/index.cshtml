@model List<AssetPortal.Models.Asset>

<h1>Asset Inventory</h1>

<a asp-controller="Assets"
   asp-action="Create"
   class="btn btn-success">
    Create Asset
</a>

<table class="table">

    <thead>
        <tr>
            <th>Actions </th>
            <th>ID</th>
            <th>Asset Tag</th>
            <th>Name</th>
            <th>Owner</th>
            <th>Purchase Date</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var asset in Model)
        {
            <tr>
                <td>@asset.Id</td>
                <td>@asset.AssetTag</td>
                <td>@asset.AssetName</td>
                <td>@asset.Owner</td>
                <td>@asset.PurchaseDate.ToShortDateString()</td>
                <td>
                    <a asp-controller="Assets"
                       asp-action="Details"
                       asp-route-id="@asset.Id"
                       class="btn btn-primary">
                        View
                    </a>
                </td>
            </tr>

        }

        </table>